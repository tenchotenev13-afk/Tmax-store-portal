#!/bin/sh
# Автоматична проверка преди всеки commit.
# Включва се веднъж с:  git config core.hooksPath .githooks
#
# Прескача се при нужда с:  git commit --no-verify

REPO=$(git rev-parse --show-toplevel)
cd "$REPO" || exit 1

# Само JS файлове от корена на репото, които влизат в този commit.
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^[^/]+\.js$')
# Нещо изобщо в commit-а? (за проверката на TESTS по-долу)
ANY=$(git diff --cached --name-only --diff-filter=ACMR)

[ -z "$STAGED" ] && [ -z "$ANY" ] && exit 0

echo ""
echo "── проверка преди commit ──────────────────────"

FAIL=0

# 1. Синтаксис на всеки променен файл
for f in $STAGED; do
  if node --check "$f" 2>/tmp/nodecheck.err; then
    echo "  ok    $f"
  else
    echo "  ГРЕШКА  $f"
    grep -v '^\s*$' /tmp/nodecheck.err | grep -v '^\s*at ' | head -4 | sed 's/^/          /'
    FAIL=1
  fi
done
rm -f /tmp/nodecheck.err

# 1b. Всеки тест от списъка TESTS трябва да е В COMMIT-А, не само на диска.
#
# Точно това счупи CI на a4b28c9: tests/run-all.js влезе в commit-а с ред за
# тестов файл, който остана некомитнат. Локално всичко минаваше — файлът си
# стоеше в работното дърво — а CI падна с „❌ ЛИПСВА ФАЙЛ".
#
# `git ls-files` чете ИНДЕКСА, не диска: файл, добавен с git add, се брои;
# непроследен файл — не. Точно разликата, която трябва да се хване.
if git ls-files --error-unmatch tests/run-all.js >/dev/null 2>&1; then
  MISSING=$(git show :tests/run-all.js 2>/dev/null \
    | sed -n "s/^[[:space:]]*'\([A-Za-z0-9._-]*\.test\.js\)'.*/\1/p" \
    | while read -r t; do
        git ls-files --error-unmatch "tests/$t" >/dev/null 2>&1 || echo "$t"
      done)
  if [ -n "$MISSING" ]; then
    echo "  ГРЕШКА  tests/run-all.js сочи към файлове извън commit-а:"
    echo "$MISSING" | sed 's/^/            · /'
    echo "            (git add tests/<файл> — иначе CI пада с „ЛИПСВА ФАЙЛ\")"
    FAIL=1
  else
    echo "  ok    всеки тест от TESTS е в commit-а"
  fi
fi

# 1c. NUL байт в изходен файл — ТВЪРД ГЕЙТ.
#
# Втори път се случва. Първият беше tests/attachments-html-sync.test.js:
# там git обяви файла за ДВОИЧЕН и това го издаде. Вторият — checklist.js
# (c6a8da2, 2 байта на позиции 11645 и 17120) — мина напълно тихо: два NUL-а
# в един файл от 17 KB не стигат git да го сметне за двоичен, затова diff-ът
# изглеждаше нормален. И в двата случая NUL-ът беше на мястото на интервал
# при програмно сглобяване на низ.
#
# Защо нищо друго не го хваща:
#   · node --check го приема — NUL вътре в стрингов литерал е валиден JS;
#   · smoke.js го приема — файлът се зарежда и работи;
#   · тестовете го приемат — ключът е симетричен от двете страни, тоест
#     търсенето в речника уцелва. 65 зелени проверки върху счупен байт.
# Единственото, което остава, е да се преброят байтовете. Затова е тук.
#
# Чете се ИНДЕКСЪТ (git show :файл), не работното дърво — комитва се той.
NULFILES=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -viE '\.(png|jpg|jpeg|gif|ico|webp|svgz|woff2?|ttf|otf|eot|pdf|zip|gz|xlsx?|docx?|pptx?)$' \
  | while read -r f; do
      n=$(git show ":$f" 2>/dev/null | tr -cd '\000' | wc -c | tr -d ' ')
      [ -n "$n" ] && [ "$n" -gt 0 ] && echo "$n  $f"
    done)
if [ -n "$NULFILES" ]; then
  echo "  ГРЕШКА  NUL байт в изходен файл (брой, файл):"
  echo "$NULFILES" | sed 's/^/            · /'
  echo "            Намери позициите:"
  echo "              node -e \"const b=require('fs').readFileSync('ФАЙЛ');\\"
  echo "                for(let i=0;i<b.length;i++)if(b[i]===0)\\"
  echo "                  console.log(i, JSON.stringify(b.slice(i-40,i+40).toString()))\""
  echo "            Обикновено е изяден интервал/разделител. Провери какво е"
  echo "            трябвало да стои там — НЕ трий байта наизуст."
  FAIL=1
else
  echo "  ok    без NUL байтове"
fi

# 2. Всички модули заредени заедно (само ако има променен JS и jsdom го има)
if [ -z "$STAGED" ]; then
  : # няма променен модул в корена — няма какво да се зарежда
elif [ ! -d node_modules/jsdom ]; then
  echo "  (jsdom липсва — smoke.js прескочен; 'npm i -D jsdom')"
else
  if node .claude/skills/tmax-jsdom-test/smoke.js . >/tmp/smoke.out 2>&1; then
    echo "  ok    всички модули се зареждат чисто"
  else
    echo ""
    echo "  smoke.js се провали:"
    if grep -qE '❌|⚠️' /tmp/smoke.out; then
      grep -E '❌|⚠️|   · ' /tmp/smoke.out | sed 's/^/    /'
    else
      tail -8 /tmp/smoke.out | sed 's/^/    /'
    fi
    FAIL=1
  fi
  rm -f /tmp/smoke.out
fi

# 3. Контекстният пакет за чата — САМО предупреждение, не спира commit-а.
#
# Пакетът е инструмент за човека (какво се качва в чата), не гейт за кода.
# Забравеният `npm run brief` е тих провал: чатът отговаря от стар контекст и
# нищо не изглежда счупено. Затова се напомня тук, но commit-ът минава.
BRIEFSRC=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(CLAUDE.md|docs/)')
if [ -n "$BRIEFSRC" ]; then
  if [ ! -f docs/BRIEF.md ]; then
    echo "  !     docs/BRIEF.md още не е генериран — npm run brief преди качване в чата"
  else
    STALE=$(for f in $BRIEFSRC; do
      [ -f "$f" ] && [ "$f" -nt docs/BRIEF.md ] && echo "$f"
    done)
    if [ -n "$STALE" ]; then
      echo "  !     docs/BRIEF.md е по-стар от:"
      echo "$STALE" | sed 's/^/            · /'
      echo "            npm run brief преди качване в чата (commit-ът НЕ е спрян)"
    else
      echo "  ok    docs/BRIEF.md е по-нов от променения контекст"
    fi
  fi
fi

echo "───────────────────────────────────────────────"

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "Commit-ът е спрян. Поправи горното или, ако знаеш какво правиш:"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

echo ""
exit 0
